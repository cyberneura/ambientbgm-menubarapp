<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Info.plist for the built app. scripts/make-app.sh copies this in with
  __VERSION__ replaced by the contents of VERSION.

  The bundle identifier is the one the app had inside the ambientbgm monorepo,
  kept so that an existing install is the same app to macOS.
-->
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>AmbientBGM Menubar</string>
	<key>CFBundleDisplayName</key>
	<string>AmbientBGM Menubar</string>
	<key>CFBundleIdentifier</key>
	<string>com.ambientbgm.menubar</string>
	<key>CFBundleExecutable</key>
	<string>AmbientBGMMenubar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.music</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- A menu bar app: no Dock icon and no main menu. -->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
